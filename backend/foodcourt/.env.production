# ── Copy this to backend/.env on your Digital Ocean server ───────────────────
# Never commit the real .env to GitHub

SECRET_KEY=replace-this-with-a-long-random-string-50-chars-minimum
DEBUG=False
ALLOWED_HOSTS=your-droplet-ip,your-domain.com

# PostgreSQL — these must match the db service in docker-compose.yml
DB_NAME=foodcourt_db
DB_USER=postgres
DB_PASSWORD=replace-this-with-a-strong-password
DB_HOST=db
DB_PORT=5432
