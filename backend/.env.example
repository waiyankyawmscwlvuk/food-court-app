# Copy this file to backend/.env and fill in real values
# NEVER commit backend/.env to git

SECRET_KEY=change-this-to-a-long-random-string-50-chars-minimum
DEBUG=False
ALLOWED_HOSTS=YOUR_DROPLET_IP,yourdomain.com

DB_NAME=foodcourt_db
DB_USER=foodcourt_user
DB_PASSWORD=StrongPasswordHere123!
DB_HOST=db
DB_PORT=5432

# Optional: comma-separated list of frontend origins (only needed if not using the nginx proxy)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://YOUR_DROPLET_IP
