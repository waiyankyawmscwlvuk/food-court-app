# Copy this file to backend/.env and fill in real values
# NEVER commit backend/.env to git

SECRET_KEY=change-this-to-a-long-random-string-50-chars-minimum
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

DB_NAME=foodcourt_db
DB_USER=foodcourt_user
DB_PASSWORD=StrongPasswordHere123!
DB_HOST=db
DB_PORT=5432

# Required for Django admin CSRF checks over HTTPS
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Optional: only needed for local dev (production uses same-origin via nginx proxy)
# CORS_ALLOWED_ORIGINS=http://localhost:5173
